+  /* Android records native crashes, ANRs and low-memory process deaths. Export
+   * the newest exit on the next launch so a phone-only report needs no adb.
+   * A native trace may be binary; keep it separate from the readable summary. */
+  private void recordPreviousProcessExit() {
+    if (logPath == null || Build.VERSION.SDK_INT < Build.VERSION_CODES.R) {
+      return;
+    }
+    try {
+      ActivityManager manager = (ActivityManager) getSystemService(Context.ACTIVITY_SERVICE);
+      if (manager == null) {
+        return;
+      }
+      List<ApplicationExitInfo> exits =
+          manager.getHistoricalProcessExitReasons(getPackageName(), 0, 8);
+      long recorded = getPreferences(MODE_PRIVATE).getLong("lastReportedExit", 0);
+      for (ApplicationExitInfo exit : exits) {
+        if (!getApplicationInfo().processName.equals(exit.getProcessName()) ||
+            exit.getTimestamp() <= recorded)
+        {
+          continue;
+        }
+        File directory = new File(logPath).getParentFile();
+        File report = new File(directory, "blender-last-exit.txt");
+        String summary = "Blender Android previous process exit\n"
+            + "time=" + new java.util.Date(exit.getTimestamp()) + "\n"
+            + "reason=" + exit.getReason() + "\n"
+            + "status=" + exit.getStatus() + "\n"
+            + "description=" + exit.getDescription() + "\n"
+            + "pss_kib=" + exit.getPss() + "\n"
+            + "rss_kib=" + exit.getRss() + "\n"
+            + "device=" + Build.MANUFACTURER + " " + Build.MODEL + "\n"
+            + "android=" + Build.VERSION.RELEASE + "\n";
+        try (FileOutputStream output = new FileOutputStream(report)) {
+          output.write(summary.getBytes(java.nio.charset.StandardCharsets.UTF_8));
+        }
+        File trace = new File(directory, "blender-last-exit.trace");
+        Files.deleteIfExists(trace.toPath());
+        try (InputStream input = exit.getTraceInputStream()) {
+          if (input != null) {
+            try (FileOutputStream output = new FileOutputStream(trace)) {
+              byte[] buffer = new byte[8192];
+              int remaining = 2 * 1024 * 1024;
+              int count;
+              while (remaining > 0 &&
+                     (count = input.read(buffer, 0, Math.min(buffer.length, remaining))) > 0)
+              {
+                output.write(buffer, 0, count);
+                remaining -= count;
+              }
+            }
+          }
+        }
+        getPreferences(MODE_PRIVATE).edit()
+            .putLong("lastReportedExit", exit.getTimestamp()).apply();
+        break;
+      }
+    }
+    catch (Exception ex) {
+      Log.w(TAG, "previous exit report unavailable", ex);
+    }
+  }
