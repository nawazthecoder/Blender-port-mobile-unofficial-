diff --git a/source/blender/gpu/vulkan/vk_shader_runtime.hh b/source/blender/gpu/vulkan/vk_shader_runtime.hh
new file mode 100644
index 00000000..e071c682
--- /dev/null
+++ b/source/blender/gpu/vulkan/vk_shader_runtime.hh
@@ -0,0 +1,67 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vulkan/vulkan_core.h>
+
+namespace blender::gpu {
+
+struct VKShaderTarget {
+  uint32_t environment;
+  uint32_t spirv_version;
+  const char *cache_directory;
+};
+
+/* Vulkan 1.1 only guarantees SPIR-V through 1.3. The compiler's desktop 1.2
+ * default can emit OpCopyLogical and other instructions older mobile drivers
+ * cannot consume. Version the cache by the actual compiler settings as well. */
+inline VKShaderTarget vk_shader_target(uint32_t api_version, bool qualcomm_workaround)
+{
+  if (api_version < VK_API_VERSION_1_2) {
+    return {VK_API_VERSION_1_1, 0x00010300, "vk11-spv13-v2"};
+  }
+  if (qualcomm_workaround) {
+    return {VK_API_VERSION_1_2, 0x00010300, "vk12-spv13-v2"};
+  }
+  return {VK_API_VERSION_1_2, 0x00010500, "vk12-spv15-v2"};
+}
+
+constexpr int64_t VK_SPIRV_CACHE_MAX_BYTES = 64 * 1024 * 1024;
+constexpr int64_t VK_PIPELINE_CACHE_MAX_BYTES = 256 * 1024 * 1024;
+
+inline bool vk_spirv_cache_size_valid(int64_t file_size, uint64_t recorded_size)
+{
+  return file_size >= 5 * int64_t(sizeof(uint32_t)) &&
+         file_size <= VK_SPIRV_CACHE_MAX_BYTES && file_size % sizeof(uint32_t) == 0 &&
+         uint64_t(file_size) == recorded_size;
+}
+
+inline bool vk_spirv_cache_header_valid(const uint32_t *words,
+                                      size_t word_count,
+                                      uint32_t maximum_version)
+{
+  return word_count >= 5 && words[0] == 0x07230203 && words[1] >= 0x00010000 &&
+         words[1] <= maximum_version && (words[1] & 0xff0000ff) == 0 && words[3] > 0 &&
+         words[4] == 0;
+}
+
+inline bool vk_pipeline_cache_size_valid(int64_t file_size,
+                                        size_t header_size,
+                                        uint64_t payload_size)
+{
+  return file_size > int64_t(header_size) && file_size <= VK_PIPELINE_CACHE_MAX_BYTES &&
+         payload_size == uint64_t(file_size) - header_size;
+}
+
+inline int vk_android_shader_compile_workers(int thread_count, uint64_t memory_bytes)
+{
+  const int limit = memory_bytes == 0 || memory_bytes < (6ull << 30) ? 2 : 4;
+  return std::clamp(thread_count, 1, limit);
+}
+
+}  // namespace blender::gpu
