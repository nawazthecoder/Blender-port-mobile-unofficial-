 {
-  const int limit = memory_bytes == 0 || memory_bytes < (6ull << 30) ? 2 : 4;
+  /* A 4 GiB phone can be killed while two EEVEE compilers and the preview allocate together.
+   * Unknown memory is conservative; roomier devices keep the previous parallelism. */
+  const int limit = memory_bytes == 0 || memory_bytes <= (4ull << 30) ?
+                        1 :
+                        (memory_bytes < (6ull << 30) ? 2 : 4);
   return std::clamp(thread_count, 1, limit);
 }
 
