diff --git a/source/blender/windowmanager/intern/wm_virtual_mouse.cc b/source/blender/windowmanager/intern/wm_virtual_mouse.cc
new file mode 100644
index 00000000..0e215fe1
--- /dev/null
+++ b/source/blender/windowmanager/intern/wm_virtual_mouse.cc
@@ -0,0 +1,192 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup wm
+ * Android relative mouse overlay. GHOST owns raw touch streams and button state; drawing here
+ * keeps the pointer and controls in the same coordinate space as Blender's virtual keyboard.
+ */
+#include "WM_api.hh"
+#include "WM_types.hh"
+#include "wm.hh"
+#include "BKE_context.hh"
+
+#ifdef __ANDROID__
+#  include <algorithm>
+#  include <cstring>
+#  include "GHOST_AndroidVirtualMouse.hh"
+#  include "DNA_screen_types.h"
+#  include "DNA_windowmanager_types.h"
+#  include "BKE_screen.hh"
+#  include "BLF_api.hh"
+#  include "GPU_immediate.hh"
+#  include "GPU_state.hh"
+#endif
+
+namespace blender {
+#ifdef __ANDROID__
+using namespace ghost::virtual_mouse;
+static wmWindow *mouse_window = nullptr;
+static void *mouse_draw_handle = nullptr;
+
+static void mouse_rect(uint pos, const Rect &rect, float height, const float color[4])
+{
+  immUniformColor4fv(color);
+  immBegin(GPU_PRIM_TRIS, 6);
+  immVertex2f(pos, rect.left, height - rect.top);
+  immVertex2f(pos, rect.right, height - rect.top);
+  immVertex2f(pos, rect.right, height - rect.bottom);
+  immVertex2f(pos, rect.left, height - rect.top);
+  immVertex2f(pos, rect.right, height - rect.bottom);
+  immVertex2f(pos, rect.left, height - rect.bottom);
+  immEnd();
+}
+
+static void mouse_arrow(uint pos, float x, float y, float scale, const float color[4])
+{
+  const float outline[][2] = {{0, 0}, {0, -25}, {6, -19}, {12, -31},
+                              {17, -28}, {11, -17}, {22, -17}};
+  immUniformColor4fv(color);
+  immBegin(GPU_PRIM_TRIS, 15);
+  for (int i = 1; i < 6; i++) {
+    immVertex2f(pos, x, y);
+    immVertex2f(pos, x + outline[i][0] * scale, y + outline[i][1] * scale);
+    immVertex2f(pos, x + outline[i + 1][0] * scale, y + outline[i + 1][1] * scale);
+  }
+  immEnd();
+}
+
+static void mouse_draw(const wmWindow *win, void * /*customdata*/)
+{
+  rcti keyboard;
+  if (WM_virtual_keyboard_rect_get(win, &keyboard)) {
+    GHOST_android_virtual_mouse_set_keyboard_rect(
+        {float(keyboard.xmin), float(win->sizey - keyboard.ymax),
+         float(keyboard.xmax), float(win->sizey - keyboard.ymin)});
+  }
+  else {
+    GHOST_android_virtual_mouse_set_keyboard_rect({});
+  }
+  State state;
+  GHOST_android_virtual_mouse_get_state(&state);
+  if (!state.enabled) {
+    return;
+  }
+  const float panel_color[4] = {0.08f, 0.08f, 0.08f, 0.97f};
+  const float key_color[4] = {0.24f, 0.24f, 0.24f, 1};
+  const float active_color[4] = {0.28f, 0.46f, 0.69f, 1};
+  const float close_color[4] = {0.42f, 0.17f, 0.15f, 1};
+  const float black[4] = {0, 0, 0, 1}, white[4] = {1, 1, 1, 1};
+  GPUVertFormat *format = immVertexFormat();
+  const uint pos = GPU_vertformat_attr_add(format, "pos", gpu::VertAttrType::SFLOAT_32_32);
+  GPU_blend(GPU_BLEND_ALPHA);
+  immBindBuiltinProgram(GPU_SHADER_3D_UNIFORM_COLOR);
+  mouse_rect(pos, state.panel, win->sizey, panel_color);
+  for (int i = 0; i < ControlCount; i++) {
+    Rect rect = state.controls[i];
+    rect.left += 2 * state.scale;
+    rect.right -= 2 * state.scale;
+    rect.top += 3 * state.scale;
+    rect.bottom -= 3 * state.scale;
+    const bool selected = (i >= Left && i <= Right && (state.held & (1 << (i - Left)))) ||
+                          (i == Hold && (state.hold_armed || state.latched));
+    mouse_rect(pos, rect, win->sizey,
+               selected ? active_color : i == Close ? close_color : key_color);
+  }
+  immUnbindProgram();
+
+  const char *labels[] = {"Move", "Left", "Middle", "Right", "Hold", "Wheel -", "Wheel +", "Close"};
+  labels[Hold] = state.latched ? "Release" : state.hold_armed ? "Armed" : "Hold";
+  const int font = BLF_default();
+  for (int i = 0; i < ControlCount; i++) {
+    const Rect &rect = state.controls[i];
+    const char *label = labels[i];
+    const size_t len = std::strlen(label);
+    float size = 13 * state.scale;
+    BLF_size(font, size);
+    const float available = rect.right - rect.left - 8 * state.scale;
+    const float width = BLF_width(font, label, len);
+    if (width > available && width > 0) {
+      size *= available / width;
+      BLF_size(font, size);
+    }
+    BLF_color4fv(font, white);
+    BLF_position(font, (rect.left + rect.right - BLF_width(font, label, len)) * 0.5f,
+                  win->sizey - (rect.top + rect.bottom) * 0.5f - size * 0.32f, 0);
+    BLF_draw(font, label, len);
+  }
+  BLF_batch_draw_flush();
+
+  /* Draw last, above the controls and keyboard. The arrow tip marks the real click position. */
+  format = immVertexFormat();
+  const uint arrow_pos = GPU_vertformat_attr_add(format, "pos", gpu::VertAttrType::SFLOAT_32_32);
+  immBindBuiltinProgram(GPU_SHADER_3D_UNIFORM_COLOR);
+  mouse_arrow(arrow_pos, state.x, win->sizey - state.y, state.scale, black);
+  mouse_arrow(arrow_pos, state.x + 2 * state.scale, win->sizey - state.y - 4 * state.scale,
+              state.scale * 0.70f, white);
+  immUnbindProgram();
+  GPU_blend(GPU_BLEND_NONE);
+}
+#endif
+
+void wm_virtual_mouse_window_close(wmWindow *win)
+{
+#ifdef __ANDROID__
+  if (mouse_window == win) {
+    GHOST_android_virtual_mouse_set_enabled(false);
+    mouse_window = nullptr;
+    mouse_draw_handle = nullptr; /* Window destruction frees its callbacks. */
+  }
+#else
+  (void)win;
+#endif
+}
+
+static wmOperatorStatus virtual_mouse_toggle_exec(bContext *C, wmOperator * /*op*/)
+{
+#ifdef __ANDROID__
+  wmWindow *win = CTX_wm_window(C);
+  if (!win) {
+    return OPERATOR_CANCELLED;
+  }
+  State state;
+  GHOST_android_virtual_mouse_get_state(&state);
+  if (mouse_window && mouse_window != win && mouse_draw_handle) {
+    WM_draw_cb_exit(mouse_window, mouse_draw_handle);
+    mouse_draw_handle = nullptr;
+  }
+  mouse_window = win;
+  if (!mouse_draw_handle) {
+    mouse_draw_handle = WM_draw_cb_activate(win, mouse_draw, nullptr);
+  }
+  GHOST_android_virtual_mouse_set_enabled(!state.enabled);
+  if (bScreen *screen = WM_window_get_active_screen(win)) {
+    screen->do_draw = true;
+  }
+  return OPERATOR_FINISHED;
+#else
+  (void)C;
+  return OPERATOR_CANCELLED;
+#endif
+}
+
+static bool virtual_mouse_poll(bContext *C)
+{
+#ifdef __ANDROID__
+  return WM_operator_winactive(C);
+#else
+  (void)C;
+  return false;
+#endif
+}
+
+void WM_OT_virtual_mouse_toggle(wmOperatorType *ot)
+{
+  ot->name = "Toggle Virtual Mouse";
+  ot->idname = "WM_OT_virtual_mouse_toggle";
+  ot->description = "Swipe to move a mouse pointer; use Left, Middle or Right to click. "
+                    "Tap Hold then a button to drag, and Release to finish. Two fingers scroll";
+  ot->exec = virtual_mouse_toggle_exec;
+  ot->poll = virtual_mouse_poll;
+}
+}  // namespace blender
