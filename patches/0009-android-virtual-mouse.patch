-  return GHOST_kFailure;
+  updateVirtualMouseViewport();
+  if (enabled && !virtual_mouse_.state().enabled) {
+    touchCancelPending();
+    touchEndPan();
+    gesture_active_ = false;
+    hover_exit_pending_ = false;
+    virtual_mouse_.sync_cursor(cursor_x_, cursor_y_);
+  }
+  virtual_mouse_.set_enabled(enabled);
+}
+
+const ghost::virtual_mouse::State &GHOST_SystemAndroid::getVirtualMouseState() const
+{
+  return virtual_mouse_.state();
+}
+
+void GHOST_SystemAndroid::setVirtualMouseKeyboardRect(ghost::virtual_mouse::Rect rect)
+{
+  virtual_mouse_.set_keyboard_rect(rect);
+}
+
+void GHOST_SystemAndroid::dispatchVirtualMouseEvent(const ghost::virtual_mouse::Event &event)
+{
+  if (!window_) {
+    return;
+  }
+  using ghost::virtual_mouse::Kind;
+  const uint64_t time = getMilliSeconds();
+  if (event.kind == Kind::Motion) {
+    cursor_x_ = event.x;
+    cursor_y_ = event.y;
+    pushEvent(std::make_unique<GHOST_EventCursor>(
+        time, GHOST_kEventCursorMove, window_, event.x, event.y, GHOST_TABLET_DATA_NONE));
+  }
+  else if (event.kind == Kind::Wheel) {
+    pushEvent(std::make_unique<GHOST_EventWheel>(
+        time, window_, GHOST_kEventWheelAxisVertical, event.delta));
+  }
+  else {
+    const GHOST_TButton button = event.button == 1 ? GHOST_kButtonMaskLeft :
+                                event.button == 2 ? GHOST_kButtonMaskMiddle :
+                                                    GHOST_kButtonMaskRight;
+    const bool down = event.kind == Kind::ButtonDown;
+    buttons_.set(button, down);
+    pushEvent(std::make_unique<GHOST_EventButton>(time,
+        down ? GHOST_kEventButtonDown : GHOST_kEventButtonUp,
+        window_, button, GHOST_TABLET_DATA_NONE));
+  }
+}
+
+void GHOST_android_virtual_mouse_set_enabled(bool enabled)
+{
+  auto *system = static_cast<GHOST_SystemAndroid *>(GHOST_ISystem::getSystem());
+  if (system) {
+    system->setVirtualMouseEnabled(enabled);
+  }
+}
+
+void GHOST_android_virtual_mouse_get_state(ghost::virtual_mouse::State *state)
+{
+  auto *system = static_cast<GHOST_SystemAndroid *>(GHOST_ISystem::getSystem());
+  *state = system ? system->getVirtualMouseState() : ghost::virtual_mouse::State{};
+}
+
+void GHOST_android_virtual_mouse_set_keyboard_rect(ghost::virtual_mouse::Rect rect)
+{
+  auto *system = static_cast<GHOST_SystemAndroid *>(GHOST_ISystem::getSystem());
+  if (system) {
+    system->setVirtualMouseKeyboardRect(rect);
+  }
 }
 
