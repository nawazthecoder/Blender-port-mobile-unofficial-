diff --git a/intern/ghost/GHOST_AndroidVirtualMouse.hh b/intern/ghost/GHOST_AndroidVirtualMouse.hh
new file mode 100644
index 00000000..d3666979
--- /dev/null
+++ b/intern/ghost/GHOST_AndroidVirtualMouse.hh
@@ -0,0 +1,393 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <functional>
+#include <utility>
+
+/* Platform-independent touch state machine. Coordinates use GHOST's top-left origin.
+ * A stream is owned from its first DOWN to its final UP, including when Close is pressed. */
+namespace ghost::virtual_mouse {
+struct Rect {
+  float left = 0, top = 0, right = 0, bottom = 0;
+  bool contains(float x, float y) const
+  {
+    return x >= left && x < right && y >= top && y < bottom;
+  }
+  bool intersects(const Rect &b) const
+  {
+    return left < b.right && right > b.left && top < b.bottom && bottom > b.top;
+  }
+};
+enum Control { Move, Left, Middle, Right, Hold, WheelDown, WheelUp, Close, ControlCount };
+enum class Kind { Motion, ButtonDown, ButtonUp, Wheel };
+struct Event {
+  Kind kind;
+  int x, y;
+  int button = 0; /* Left = 1, Middle = 2, Right = 4. */
+  int delta = 0;
+};
+struct Point {
+  int id;
+  float x, y;
+};
+struct State {
+  bool enabled = false;
+  bool hold_armed = false;
+  int held = 0, latched = 0;
+  float x = 0, y = 0, scale = 1;
+  Rect panel;
+  std::array<Rect, ControlCount> controls;
+};
+
+class Controller {
+ public:
+  explicit Controller(std::function<void(const Event &)> emit) : emit_(std::move(emit)) {}
+  const State &state() const { return state_; }
+  bool capturing() const { return captured_; }
+
+  void set_viewport(int width, int height, float scale)
+  {
+    width = std::max(1, width);
+    height = std::max(1, height);
+    scale = std::clamp(scale, 0.65f, 3.0f);
+    if (width == width_ && height == height_ && scale == state_.scale) {
+      return;
+    }
+    cancel(true);
+    width_ = width;
+    height_ = height;
+    state_.scale = scale;
+    if (!positioned_) {
+      state_.x = width * 0.5f;
+      state_.y = height * 0.5f;
+      state_.panel.left = width * 0.5f - panel_width() * 0.5f;
+      state_.panel.top = 38 * scale;
+      positioned_ = true;
+    }
+    sync_cursor(state_.x, state_.y);
+    layout();
+  }
+  void set_keyboard_rect(Rect rect)
+  {
+    keyboard_ = rect;
+    layout();
+    const float old_x = state_.x, old_y = state_.y;
+    sync_cursor(state_.x, state_.y);
+    if (state_.enabled && (old_x != state_.x || old_y != state_.y)) {
+      motion();
+    }
+  }
+  void sync_cursor(float x, float y)
+  {
+    state_.x = std::clamp(x, 0.0f, float(width_ - 1));
+    state_.y = std::clamp(y, 0.0f, float(height_ - 1));
+    if (state_.enabled && keyboard_.contains(state_.x, state_.y)) {
+      /* Keyboard keys use direct touch. Never let its event filter swallow the release of a
+       * mouse drag that began in an editor. Snap to the closest visible edge of the keyboard. */
+      float distance = float(width_ + height_);
+      float target_x = state_.x, target_y = state_.y;
+      const auto candidate = [&](float px, float py) {
+        if (px < 0 || py < 0 || px >= width_ || py >= height_ || keyboard_.contains(px, py)) {
+          return;
+        }
+        const float d = std::hypot(px - state_.x, py - state_.y);
+        if (d < distance) {
+          distance = d;
+          target_x = px;
+          target_y = py;
+        }
+      };
+      candidate(keyboard_.left - 1, state_.y);
+      candidate(keyboard_.right, state_.y);
+      candidate(state_.x, keyboard_.top - 1);
+      candidate(state_.x, keyboard_.bottom);
+      state_.x = target_x;
+      state_.y = target_y;
+    }
+  }
+  void set_enabled(bool enabled)
+  {
+    if (state_.enabled == enabled) {
+      return;
+    }
+    cancel(true);
+    state_.enabled = enabled;
+    if (enabled) {
+      sync_cursor(state_.x, state_.y);
+      motion();
+    }
+  }
+  /* Keep ownership until UP when a surface changes or the user closes the bar mid-gesture. */
+  void cancel(bool keep_capture = false)
+  {
+    touches_ = {};
+    state_.latched = 0;
+    state_.hold_armed = false;
+    sync_buttons();
+    wheel_remainder_ = 0;
+    suppressed_ = captured_ && keep_capture;
+    captured_ = suppressed_;
+  }
+  bool begin(int id, float x, float y, uint64_t time)
+  {
+    if (captured_) {
+      cancel();
+    }
+    touches_ = {};
+    wheel_remainder_ = 0;
+    if (!state_.enabled || keyboard_.contains(x, y)) {
+      return false;
+    }
+    captured_ = true;
+    add(id, x, y, time);
+    return true;
+  }
+  void pointer_down(int id, float x, float y, uint64_t time)
+  {
+    if (!captured_ || suppressed_) {
+      return;
+    }
+    for (Touch &touch : touches_) {
+      touch.tap = false;
+    }
+    add(id, x, y, time);
+    for (Touch &touch : touches_) {
+      touch.tap = false;
+    }
+    wheel_remainder_ = 0;
+  }
+  void move(const Point *points, int count)
+  {
+    if (!captured_ || suppressed_) {
+      return;
+    }
+    int pads = 0;
+    float dx = 0, dy = 0;
+    bool primary = false;
+    for (Touch &touch : touches_) {
+      if (!touch.active) {
+        continue;
+      }
+      for (int i = 0; i < count; i++) {
+        if (points[i].id != touch.id) {
+          continue;
+        }
+        const float mx = points[i].x - touch.x;
+        const float my = points[i].y - touch.y;
+        touch.x = points[i].x;
+        touch.y = points[i].y;
+        if (std::hypot(touch.x - touch.start_x, touch.y - touch.start_y) > 6 * state_.scale) {
+          touch.tap = false;
+        }
+        if (touch.role == Role::Pad) {
+          pads++;
+          /* The first live pad controls dragging, irrespective of Android's pointer indices. */
+          if (!primary || state_.held == 0) {
+            dx += mx;
+            dy += my;
+          }
+          primary = true;
+        }
+        else if (touch.role == Role::Grip) {
+          state_.panel.left += mx;
+          state_.panel.top += my;
+          layout();
+        }
+        break;
+      }
+    }
+    if (pads >= 2 && state_.held == 0) {
+      for (Touch &touch : touches_) {
+        touch.tap = false;
+      }
+      wheel_remainder_ += dy / pads;
+      const float step = 32 * state_.scale;
+      /* Android finger-down motion scrolls content down: send a positive wheel notch. */
+      while (std::abs(wheel_remainder_) >= step) {
+        const int delta = wheel_remainder_ > 0 ? 1 : -1;
+        wheel(delta);
+        wheel_remainder_ -= delta * step;
+      }
+    }
+    else if (pads > 0 && (dx != 0 || dy != 0)) {
+      sync_cursor(state_.x + dx, state_.y + dy);
+      motion();
+    }
+  }
+  void pointer_up(int id, uint64_t time, bool final)
+  {
+    if (!captured_) {
+      return;
+    }
+    for (Touch &touch : touches_) {
+      if (!touch.active || touch.id != id) {
+        continue;
+      }
+      const bool click = !suppressed_ && touch.role == Role::Pad && touch.tap &&
+                         time - touch.time <= 300 && state_.held == 0;
+      touch.active = false;
+      sync_buttons();
+      if (click && !state_.panel.contains(state_.x, state_.y)) {
+        motion();
+        emit_({Kind::ButtonDown, int(state_.x), int(state_.y), 1});
+        emit_({Kind::ButtonUp, int(state_.x), int(state_.y), 1});
+      }
+      break;
+    }
+    wheel_remainder_ = 0;
+    if (final) {
+      touches_ = {};
+      sync_buttons(); /* Latched buttons deliberately survive lifting the last finger. */
+      captured_ = suppressed_ = false;
+    }
+  }
+
+ private:
+  enum class Role { Pad, Button, Grip, Ignore };
+  struct Touch {
+    bool active = false, tap = false;
+    int id = -1, button = 0;
+    Role role = Role::Ignore;
+    float x = 0, y = 0, start_x = 0, start_y = 0;
+    uint64_t time = 0;
+  };
+  State state_;
+  Rect keyboard_;
+  std::array<Touch, 10> touches_{};
+  std::function<void(const Event &)> emit_;
+  int width_ = 1, height_ = 1;
+  bool captured_ = false, suppressed_ = false, positioned_ = false;
+  float wheel_remainder_ = 0;
+
+  float panel_width() const { return std::min(float(width_), 432 * state_.scale); }
+  void layout()
+  {
+    const float w = panel_width(), h = std::min(float(height_), 52 * state_.scale);
+    state_.panel.left = std::clamp(state_.panel.left, 0.0f, float(width_) - w);
+    state_.panel.top = std::clamp(state_.panel.top, 0.0f, float(height_) - h);
+    state_.panel.right = state_.panel.left + w;
+    state_.panel.bottom = state_.panel.top + h;
+    if (state_.panel.intersects(keyboard_)) {
+      if (keyboard_.top >= h) {
+        state_.panel.top = keyboard_.top - h;
+      }
+      else if (keyboard_.bottom + h <= height_) {
+        state_.panel.top = keyboard_.bottom;
+      }
+      state_.panel.bottom = state_.panel.top + h;
+    }
+    for (int i = 0; i < ControlCount; i++) {
+      state_.controls[i] = {state_.panel.left + w * i / float(ControlCount),
+                            state_.panel.top,
+                            state_.panel.left + w * (i + 1) / float(ControlCount),
+                            state_.panel.bottom};
+    }
+  }
+  void motion() { emit_({Kind::Motion, int(state_.x), int(state_.y)}); }
+  void wheel(int delta)
+  {
+    if (!state_.panel.contains(state_.x, state_.y)) {
+      motion();
+      emit_({Kind::Wheel, int(state_.x), int(state_.y), 0, delta});
+    }
+  }
+  void sync_buttons()
+  {
+    int next = state_.latched;
+    for (const Touch &touch : touches_) {
+      if (touch.active && touch.role == Role::Button) {
+        next |= touch.button;
+      }
+    }
+    if (next == state_.held) {
+      return;
+    }
+    motion();
+    for (int button : {1, 2, 4}) {
+      if ((state_.held & button) && !(next & button)) {
+        emit_({Kind::ButtonUp, int(state_.x), int(state_.y), button});
+      }
+    }
+    for (int button : {1, 2, 4}) {
+      if ((next & button) && !(state_.held & button)) {
+        emit_({Kind::ButtonDown, int(state_.x), int(state_.y), button});
+      }
+    }
+    state_.held = next;
+  }
+  void add(int id, float x, float y, uint64_t time)
+  {
+    Touch *slot = nullptr;
+    for (Touch &touch : touches_) {
+      if (!touch.active) {
+        slot = &touch;
+        break;
+      }
+    }
+    if (!slot) {
+      return;
+    }
+    *slot = {true, true, id, 0, Role::Pad, x, y, x, y, time};
+    if (keyboard_.contains(x, y)) {
+      slot->role = Role::Ignore;
+      slot->tap = false;
+      return;
+    }
+    for (int i = 0; i < ControlCount; i++) {
+      if (!state_.controls[i].contains(x, y)) {
+        continue;
+      }
+      slot->tap = false;
+      slot->role = Role::Ignore;
+      if (i == Move) {
+        slot->role = Role::Grip;
+      }
+      else if (i >= Left && i <= Right && !state_.panel.contains(state_.x, state_.y)) {
+        const int button = 1 << (i - Left);
+        if (state_.latched & button) {
+          state_.latched &= ~button;
+        }
+        else if (state_.hold_armed) {
+          state_.latched |= button;
+          state_.hold_armed = false;
+        }
+        else {
+          slot->role = Role::Button;
+          slot->button = button;
+        }
+        sync_buttons();
+      }
+      else if (i == Hold) {
+        if (state_.latched) {
+          state_.latched = 0;
+          state_.hold_armed = false;
+          sync_buttons();
+        }
+        else {
+          state_.hold_armed = !state_.hold_armed;
+        }
+      }
+      else if (i == WheelDown || i == WheelUp) {
+        wheel(i == WheelUp ? 1 : -1);
+      }
+      else if (i == Close) {
+        set_enabled(false);
+      }
+      return;
+    }
+    /* A pad that begins while a button is held moves only; lifting must never add a click. */
+    slot->tap = state_.held == 0;
+  }
+};
+}  // namespace ghost::virtual_mouse
+
+#ifdef __ANDROID__
+void GHOST_android_virtual_mouse_set_enabled(bool enabled);
+void GHOST_android_virtual_mouse_get_state(ghost::virtual_mouse::State *state);
+void GHOST_android_virtual_mouse_set_keyboard_rect(ghost::virtual_mouse::Rect rect);
+#endif
