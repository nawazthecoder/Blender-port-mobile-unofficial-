+
+void GHOST_SystemAndroid::updateVirtualMouseViewport()
+{
+  if (window_) {
+    GHOST_Rect bounds;
+    window_->getClientBounds(bounds);
+    virtual_mouse_.set_viewport(bounds.getWidth(), bounds.getHeight(),
