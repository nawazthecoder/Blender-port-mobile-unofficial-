index 686250cd..72ac4c2e 100644
--- a/source/blender/windowmanager/intern/wm_files.cc
+++ b/source/blender/windowmanager/intern/wm_files.cc
@@ -505,6 +505,14 @@ static void wm_file_read_setup_wm_finalize(bContext *C,
 
 static void wm_gpu_backend_override_from_userdef()
 {
+#ifdef __ANDROID__
+  /* Android ships only the Vulkan backend. Desktop factory/imported preferences
+   * otherwise request OpenGL (or Metal), triggering a needless fallback. */
+  if (ELEM(U.gpu_backend, USER_GPU_BACKEND_OPENGL, USER_GPU_BACKEND_METAL)) {
+    U.gpu_backend = USER_GPU_BACKEND_VULKAN;
+  }
+#endif
+
   /* Check if GPU backend is already set from the command line arguments. The command line
    * arguments have higher priority than user preferences. */
   if (GPU_backend_type_selection_is_overridden()) {
