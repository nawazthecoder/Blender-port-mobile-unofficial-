+    const int direction = (data->drag_accum > 0) ? 1 : -1;
+    if (direction > 0) {
+      if (!data->items.more) {
+        /* Drained, so the hand does not have to give back what it pushed past the end. */
+        data->drag_accum = 0;
+        break;
+      }
+      data->items.offset++;
+    }
+    else {
+      if (data->items.offset == 0) {
+        data->drag_accum = 0;
+        break;
+      }
+      data->items.offset--;
+    }
+    data->drag_accum -= direction * row_h;
