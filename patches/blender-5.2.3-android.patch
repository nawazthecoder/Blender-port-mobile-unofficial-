+# remapping old indices to new position in list
+def bridge_update_old_selection(bm, old_selected_faces):
+    """
+    old_indices = old_selected_faces[:]
+    old_selected_faces = []
+    for i, face in enumerate(bm.faces):
+        if face.index in old_indices:
