+# return a string with the input method
+def bridge_input_method(loft, loft_loop):
+    method = ""
+    if loft:
+        if loft_loop:
+            method = "Loft loop"
+        else:
+            method = "Loft no-loop"
+    else:
+        method = "Bridge"
+
+    return(method)
