+        move = []
+        for loop in loops:
+            # calculate plane and position of vertices on them
+            com, normal = calculate_plane(bm, loop, method=self.plane,
+                object=object)
+            to_move = flatten_project(bm, loop, com, normal)
+            if self.restriction == 'none':
