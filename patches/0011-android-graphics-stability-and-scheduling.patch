+void GHOST_android_wait_for_events(int32_t timeout_us)
+{
+  /* Polling readiness does not consume the command/input fd. Its source is processed by
+   * android_main, keeping lifecycle changes outside an in-progress Blender iteration. */
+  const int timeout_ms = timeout_us > 0 ? (timeout_us + 999) / 1000 : 0;
+  ALooper_pollOnce(timeout_ms, nullptr, nullptr, nullptr);
+}
+
+static bool android_can_draw(const android_app *app)
+{
+  return g_context && app->window && app->activityState == APP_CMD_RESUME;
+}
+
+bool GHOST_android_is_drawable()
+{
+  const android_app *app = GHOST_SystemAndroid::getAndroidApp();
+  return app && android_can_draw(app);
+}
