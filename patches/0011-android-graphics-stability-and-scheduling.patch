+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <cstdint>
+#include <optional>
+#include <vulkan/vulkan.h>
+
+struct GHOST_VulkanAcquireResult {
+  VkResult result = VK_NOT_READY;
+  std::optional<uint32_t> image_index;
+};
+
+/* An error never supplies an owned image. Retry only OUT_OF_DATE, with a finite bound so an
+ * Android resize storm cannot starve input/lifecycle processing. SUBOPTIMAL owns a valid image. */
+template<typename Acquire, typename Recreate>
+GHOST_VulkanAcquireResult GHOST_vulkan_acquire_image(Acquire acquire, Recreate recreate,
+                                                   uint32_t max_attempts = 3)
+{
+  VkResult result = VK_NOT_READY;
+  for (uint32_t attempt = 0; attempt < max_attempts; attempt++) {
+    uint32_t image_index = 0;
+    result = acquire(&image_index);
+    if (result == VK_SUCCESS || result == VK_SUBOPTIMAL_KHR) {
+      return {result, image_index};
+    }
+    if (result != VK_ERROR_OUT_OF_DATE_KHR || attempt + 1 == max_attempts || !recreate()) {
+      break;
+    }
+  }
+  return {result, std::nullopt};
+}
