+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+#include <vulkan/vulkan.h>
+
+namespace blender::gpu::render_graph {
+
+inline bool image_subresource_ranges_equal(const VkImageSubresourceRange &a,
+                                           const VkImageSubresourceRange &b)
+{
+  return a.aspectMask == b.aspectMask && a.baseMipLevel == b.baseMipLevel &&
+         a.levelCount == b.levelCount && a.baseArrayLayer == b.baseArrayLayer &&
+         a.layerCount == b.layerCount;
+}
+
+/* Only barriers describing the same subresources can be folded into one transition. Dropping
+ * another mip/layer/aspect leaves it in its old layout, even if the VkImage handle matches. */
+inline bool image_barrier_try_merge(VkImageMemoryBarrier &current,
+                                    const VkImageMemoryBarrier &next)
+{
+  if (current.image != next.image || current.pNext || next.pNext ||
+      current.srcQueueFamilyIndex != next.srcQueueFamilyIndex ||
+      current.dstQueueFamilyIndex != next.dstQueueFamilyIndex ||
+      !image_subresource_ranges_equal(current.subresourceRange, next.subresourceRange))
+  {
+    return false;
+  }
+  const bool same_transition = current.oldLayout == next.oldLayout &&
+                               current.newLayout == next.newLayout;
+  const bool chained_transition = current.newLayout == next.oldLayout;
+  if (!same_transition && !chained_transition) {
+    return false;
+  }
+  current.srcAccessMask |= next.srcAccessMask;
+  current.dstAccessMask |= next.dstAccessMask;
+  if (chained_transition) {
+    current.newLayout = next.newLayout;
+  }
+  return true;
+}
+
+/* Identical write flags still require a dependency (WAW); read/read does not. */
+inline bool image_access_needs_dependency(VkAccessFlags previous, VkAccessFlags next)
+{
+  constexpr VkAccessFlags writes = VK_ACCESS_SHADER_WRITE_BIT |
+      VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT |
+      VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_HOST_WRITE_BIT | VK_ACCESS_MEMORY_WRITE_BIT;
+  return previous != 0 && ((previous | next) & writes) != 0;
+}
+}  // namespace blender::gpu::render_graph
