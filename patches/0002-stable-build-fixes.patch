@@ -35,6 +35,10 @@ ADRENOTOOLS_ARGS=()
 OIDN_ARGS=()
 [ -z "${BLENDER_ANDROID_OIDN_ROOT:-}" ] || OIDN_ARGS=(-DANDROID_OIDN_ROOT="$BLENDER_ANDROID_OIDN_ROOT")
 FEATURES="build_files/android/android_features_$CONFIG.cmake"
+LAUNCHER_ARGS=()
